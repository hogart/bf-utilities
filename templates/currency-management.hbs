<form class="currency-management bf-utilities-form">
  <fieldset>
    <legend>How much money?</legend>

    {{#each currencies}}
      <bfu-currency-input amount="0" name="{{this.name}}" img="{{this.img}}" label="{{this.label}}"></bfu-currency-input>
    {{/each}}
  </fieldset>

  <fieldset>
    <legend>Transaction type</legend>

    <div class="form-group">
      <select name="transaction">
        <option value="receive" selected>Receive</option>
        <option value="spend">Spend</option>
        {{#if hasGM}}
          <option value="transfer">Transfer</option>
        {{/if}}
      </select>
    </div>
  </fieldset>

  <fieldset class="transfer">
    <legend>Transfer to:</legend>

    {{#each fellows}}
      <bfu-actor-selector actor-id="{{this.id}}" name="{{this.name}}" img="{{this.img}}"></bfu-actor-selector>
    {{/each}}
  </fieldset>

  <div class="actions">
    <button type="submit">Confirm</button>
  </div>
</form>