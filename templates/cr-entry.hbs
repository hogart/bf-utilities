<div class="form-group creature-group">
  <label>
    CR:
    <select name="cr">
      <option>—</option>
      {{#each xpTable}}
        <option
          value="{{ xp }}"
          {{#if (eq cr ../creatureCr)}}selected{{/if}}
        >
          {{ cr }} ({{ xp }})
        </option>
      {{/each}}
    </select>
  </label>
  <label>
    Quantity:
    <input type="number" name="quantity" min="1" value="{{ creatureCount }}"/>
  </label>
  <label>
    &nbsp;
    <button type="button" class="remove-creature-btn" title="Remove the creature">
      <i class="fas fa-trash"></i>
    </button>
  </label>
</div>