<div class="party-sheet {{#if isGM}}isGM{{/if}} {{#if enableDistributeCurrency}}enable-distribute-currency{{/if}} {{#if enableGrantXp}}enable-grant-xp{{/if}} ">
  {{#if isGM}}
    <div class="actions">
      <button data-action="distribute-currency">
        <i class="fas fa-coins"></i>
        Distribute currency
      </button>

      <button data-action="grant-xp">
        <i class="fa-solid fa-arrow-down-up-across-line"></i>
        Grant XP
      </button>

      <bfu-doom-points points="{{doomPoints}}"></bfu-doom-points>
    </div>
  {{/if}}
  <ul class="pc-items">
    {{#each actors}}
      <li class="pc-item {{#if isOwner}}isOwner{{/if}}">
        <div class="pc-portrait">
          <bfu-pc-portrait
            name="{{name}}"
            img="{{img}}"
            actor-id="{{_id}}"
            senses="{{senses}}"
            type="{{type}}"
            size="{{size}}"
            movement="{{movement}}"
            data-open-sheet
          ></bfu-pc-portrait>

          <meter
            max="{{hp.max}}"
            value="{{hp.value}}"
            data-display="{{hp.value}}{{#if hp.thp}}+{{hp.thp}}{{/if}}/{{hp.max}}"
          ></meter>

          <div class="protection">
            <span title="AC: {{ac.label}}">
              <i class="fas fa-shield-halved"></i>
              {{ac.value}}
            </span>
            <span title="Hit Dice">
              <i class="fas fa-campground"></i>
              {{hd.available}}/{{hd.max}}
            </span>
          </div>
        </div>
        <div class="pc-info">
          <div class="pc-header">
            <a class="name" data-open-sheet="{{@index}}">{{name}}</a>

            <p class="character-classes">
              {{#each classes}}
                <bfu-feature-link
                  img="{{img}}"
                  alt="{{name}}"
                  item-id="{{_id}}"
                  label="{{name}} {{levels}}"
                ></bfu-feature-link>
              {{/each}}
            </p>
          </div>

          <bfu-pc-origin
            heritage="{{jsonattr heritage}}"
            lineage="{{jsonattr lineage}}"
            background="{{jsonattr background}}"
            data-open-feature
          ></bfu-pc-origin>

          <bfu-pc-skills skills="{{jsonattr highestSkills}}"></bfu-pc-skills>

          <div class="misc">
            <span title="Luck" class="luck">
              <a data-remove-luck="{{@index}}" title="Remove luck point" class="gm-only owner-only">
                <i class="fas fa-minus"></i>
              </a>
              <i class="fas fa-clover"></i>
              {{luck}}
              <a data-grant-luck="{{@index}}" title="Add luck point" class="gm-only owner-only">
                <i class="fas fa-plus"></i>
              </a>
            </span>
            <span title="Attuned Items">
              <i class="fa-solid fa-sun"></i>
              {{attunement.value}}/{{attunement.max}}
            </span>
            <span title="Wealth: {{coinage}}">
              <a data-manage-currency="{{@index}}" class="luck {{#if isOwner}}active{{/if}} {{#if @root.isGM}}active{{/if}}">
                <i class="fas fa-coins"></i>
              </a>
              {{wealth}}
            </span>
          </div>
        </div>
      </li>
    {{/each}}
  </ul>
</div>