{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ESNext",
    "module": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "moduleResolution": "NodeNext",
    "types": ["fvtt-types/lenient", "@types/jquery"],
  },
  "include": ["scripts/**/*.mjs", "types.d.ts"],
  "exclude": ["node_modules"]
}
